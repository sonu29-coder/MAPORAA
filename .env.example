# MAPORAA Environment Configuration Example
# Copy this file to .env and configure appropriate values for your deployment.

# Service
PROJECT_NAME="MAPORAA"
VERSION="1.0.0"

# Database Configuration
# Default is local SQLite: sqlite:///./maporaa.db
# Or PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maporaa
DATABASE_URL="sqlite:///./maporaa.db"

# Security & Authentication
# Generate a secure 32+ character key in production: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload & Processing Storage
UPLOAD_DIR="./uploads"
ARTIFACT_DIR="./artifacts"
MAX_UPLOAD_SIZE_MB=250

# CORS Allowed Origins (Comma separated or json array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
